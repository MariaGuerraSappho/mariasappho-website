---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Tile from '../../../components/Tile.astro';
import Filters from '../../../components/Filters.astro';
import WorkTabs from '../../../components/WorkTabs.astro';
import { themes, workTypes } from '../../../data/site';

const works = (await getCollection('works')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title));
const research = await getCollection('research');
const usedThemes = Object.fromEntries(Object.entries(themes).filter(([k]) => k !== 'instruments' && works.some((w) => w.data.themes.includes(k))));
const words = (...parts: unknown[]) => parts.flat().filter(Boolean).join(' ').toLowerCase();
---
<Base title="All works" description="Every work by Maria Sappho, searchable and filterable by type and theme.">
  <h1 class="page-title">Work</h1>
  <WorkTabs current="all" />
  <Filters search noun="works" placeholder="Search all work" groups={[{ key: 'type', label: 'Type', options: workTypes, runes: true }, { key: 'theme', label: 'Theme', options: usedThemes }]} />
  <div class="tiles">
    {works.map((w) => (
      <Tile href={`/work/${w.id}/`} title={w.data.title} kind={w.data.tags[0]} filters={[...w.data.tags, ...w.data.themes, ...(w.data.themes.includes('instruments') ? ['instrument'] : [])]}
        label={[workTypes[w.data.tags[0] as keyof typeof workTypes], w.data.year].filter(Boolean).join(' · ')}
        search={words(w.data.title, w.data.subtitle, w.data.year, w.data.tags, w.data.themes, w.data.collaborations, (w.body ?? '').slice(0, 400))} />
    ))}
    {research.map((r) => (
      <Tile href={`/research/${r.id}/`} title={r.data.title} kind={r.data.type} searchOnly label="Research" filters={[...r.data.themes]}
        search={words(r.data.title, r.data.authors, r.data.venue, r.data.year, r.data.themes, (r.body ?? '').slice(0, 300))} />
    ))}
  </div>
</Base>
