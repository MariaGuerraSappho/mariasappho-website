---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Carousel from '../../components/Carousel.astro';
import Entry from '../../components/Entry.astro';
import Audio from '../../components/Audio.astro';
import GoFurther from '../../components/GoFurther.astro';
import ReadMore from '../../components/ReadMore.astro';
import Tile from '../../components/Tile.astro';
import { site, themes, workTypes } from '../../data/site';

export async function getStaticPaths() {
  return (await getCollection('works')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const research = (await getCollection('research')).filter((r) => r.data.works.includes(entry.id) || d.research.includes(r.id));
const all = await getCollection('works');
const related = all.filter((w) => w.id !== entry.id && (d.related.includes(w.id) || w.data.related.includes(entry.id)));
const collabs = (await Promise.all(d.collaborations.map((c) => getEntry('collaborations', c)))).filter(Boolean);
const requestBody = `Hello Maria,\n\nI would like to request the full score of ${d.title}.\n\nName:\nEnsemble or institution:\nFor (perusal, performance, study or teaching):\nPerformance date, venue and city, if known:\n`;
const request = { label: 'Request the full score', url: `mailto:${site.email}?subject=${encodeURIComponent(`Score request: ${d.title}`)}&body=${encodeURIComponent(requestBody)}` };
const links = d.scoreRequest ? [request, ...d.links] : d.links;
const score = links.find((l) => /score/i.test(l.label));
const typeLabel = (t: string) => (t === 'score' ? 'All scores' : workTypes[t as keyof typeof workTypes]);
const images = d.tags[0] === 'score' && !d.scoreRequest ? [] : d.cover ? [d.cover, ...d.gallery] : d.gallery;
---
<Base title={d.title} description={d.subtitle ? `${d.title} by Maria Sappho: ${d.subtitle}` : `${d.title} by Maria Sappho`} ogImage={d.cover?.src}>
  <Entry title={d.title} subtitle={d.subtitle} meta={d.year?.toString()} kind={d.tags[0]} seed={`/work/${entry.id}/`} trail={[{ href: '/work/', label: 'Work' }, { href: `/work/all/?type=${d.tags[0]}`, label: typeLabel(d.tags[0]) }]} stage={images.length === 0 && d.videos.length === 0}>
    <Fragment slot="rail">
      {score && <ul class="rail-links"><li><a href={score.url} rel="noopener" target={d.scoreRequest ? undefined : '_blank'}>{d.scoreRequest ? request.label : 'Open the score'}</a></li></ul>}
      <p class="rail-tags">
        {d.tags.map((t) => <a href={`/work/all/?type=${t}`}>{typeLabel(t)}</a>)}
        {d.themes.filter((t) => !(t === 'instruments' && d.tags.includes('instrument'))).map((t) => <a href={`/themes/${t}/`}>{themes[t as keyof typeof themes]}</a>)}
        {collabs.map((c) => <a href={`/collaborations/${c!.id}/`}>{c!.data.title}</a>)}
      </p>
    </Fragment>
    <Carousel title={d.title} videos={d.videos} images={images} />
    <Audio title={d.title} audio={d.audio} />
    <ReadMore><Content /></ReadMore>
    <GoFurther links={links} />
    {research.length > 0 && (
      <section class="linked">
        <h2>Related research</h2>
        <div class="tiles small">{research.map((r) => <Tile href={`/research/${r.id}/`} title={r.data.title} kind={r.data.type} />)}</div>
      </section>
    )}
    {related.length > 0 && (
      <section class="linked">
        <h2>Related work</h2>
        <div class="tiles small">{related.map((w) => <Tile href={`/work/${w.id}/`} title={w.data.title} kind={w.data.tags[0]} />)}</div>
      </section>
    )}
  </Entry>
</Base>
