---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import Filters from '../../components/Filters.astro';
import { researchTypes, themes, workTypes } from '../../data/site';

const works = await getCollection('works');
const research = await getCollection('research');
const collaborations = await getCollection('collaborations');
const words = (...parts: unknown[]) => parts.flat().filter(Boolean).join(' ').toLowerCase();
const themeNames = (keys: string[]) => keys.map((k) => themes[k as keyof typeof themes]);
---
<Base title="Search" description="Search all of Maria Sappho's work, research and collaborations.">
  <h1 class="page-title">Search</h1>
  <Filters search focus placeholder="Search everything" hint="Try a title, a person, a place, a year or an idea." />
  <div class="tiles">
    {works.map((w) => (
      <Tile href={`/work/${w.id}/`} title={w.data.title} kind={w.data.tags[0]} searchOnly
        label={[workTypes[w.data.tags[0] as keyof typeof workTypes], w.data.year].filter(Boolean).join(' · ')}
        search={words(w.data.title, w.data.subtitle, w.data.year, w.data.tags, themeNames(w.data.themes), w.data.collaborations, (w.body ?? '').slice(0, 400))} />
    ))}
    {research.map((r) => (
      <Tile href={`/research/${r.id}/`} title={r.data.title} kind={r.data.type} searchOnly
        label={['Research', r.data.year].filter(Boolean).join(' · ')}
        search={words(r.data.title, r.data.authors, r.data.venue, r.data.year, themeNames(r.data.themes), (r.body ?? '').slice(0, 300))} />
    ))}
    {collaborations.map((c) => (
      <Tile href={`/collaborations/${c.id}/`} title={c.data.title} kind="collaboration" searchOnly label="Collaboration"
        search={words(c.data.title, c.data.summary, (c.body ?? '').slice(0, 300))} />
    ))}
  </div>
</Base>
